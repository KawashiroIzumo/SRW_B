/// @description Insert description here
// You can write your code in this editor
if(ondrawing2&&battle_dh==true)
{
	var vx,vy,vw,vh,ax,ay,aw,ah,i,vxs,vys;
	if(!surface_exists(battleground))
	{
		battleground=surface_create(ground_width,ground_height)
	}
	if((jd==0||jd==4)&&fw_flag=false)
	{
	    i=0
	    if(jd==4)i=1
	    if(upside_down)i=!i
		actors_alpha[i]=1
		actors_alpha[!i]=0
		bk_speed=(i*2-1)*-2
		vx=actors_x[i+2]
		vy=actors_y[i+2]
	    var dis=point_distance(vx,vy,battlecam_x,battlecam_y)
	    //show_message("dis="+string(dis))
	    if(dis<20)
	    {
	        battlecam_x=vx
	        battlecam_y=vy
	        alarm[2]=60
	        fw_flag=true
	    }
	    else
	    {
	        var dre;
	        dre=point_direction(battlecam_x,battlecam_y,vx,vy)
	        battlecam_x+=dcos(dre)*20
	        battlecam_y-=dsin(dre)*20
	        fw_flag=false
	    }
	}
	surface_set_target(battleground)
	draw_clear(0)
	vw=1280/battlecam_blv
	vh=720/battlecam_blv
	vx=battlecam_x
	vy=battlecam_y
	//show_message("vx="+string(vx)+"  vy="+string(vy))
	for(i=0;i<128;i++)//计算运动
	{
		bks_x[i]+=bk_speed
	}
	if(bk_speed_offset>0)//运动速度变化
	{
		bk_speed_offset=abs(bk_speed_offset)
		if(bk_speed>bk_speed_target)bk_speed-=bk_speed_offset
		else if(bk_speed<bk_speed_target)bk_speed+=bk_speed_offset
		if(abs(bk_speed-bk_speed_target)<bk_speed_offset)
		{
			bk_speed_offset=0
			bk_speed=bk_speed_target
			bk_speed_target=0
		}
	}
	//draw_sprite(bks00_earthsky,0,0,battlecam_y-2160)
	for(i=0;i<128;i++)
	{
		if(bks_front[i])continue;
		else if(!sprite_exists(bks[i]))continue;
		ax=bks_xspeed_blv[i]*bks_x[i]
		ay=bks_y[i]
		ah=sprite_get_height(bks[i])
		aw=sprite_get_width(bks[i])
		/*if(ay+ah<0||ay>vy+vh)
		{
			continue;
		}*/
		if(aw>0)
		{
			while(ax>0)
			{
				ax-=aw
			}
			var bx=ax;
			while(bx<=ground_width)
			{
				draw_sprite_ext(bks[i],image_index,bx,ay,1,1,0,c_white,bks_alpha[i])
				bx+=aw
			}
		}
	}
	for(i=0;i<384;i++)//绘制演员
	{
	    if(sprite_exists(actors_sprite[i])&&actors_sprite[i]!=noone)
	    {
			//gpu_set_blendenable(true)
	        if(actors_blend[i]!=bm_normal)gpu_set_blendmode(actors_blend[i])
	        //show_message("actors_y[i]="+string(actors_y[i]))
	        vx=actors_x[i]
	        vy=actors_y[i]
			//show_message("vx="+string(vx)+" vy="+string(vy))
	        if(actors_follow[i])
	        {
	            vx=battlecam_x+640
				vy=battlecam_y+360
	        }
	        vxs=actors_xs[i]
	        vys=actors_ys[i]
			var a;
			if(actors_skeleton_animation[i]=="")
			{
				with(actors_object[i])
				{
					sprite_index=other.actors_sprite[i]
					image_index=other.actors_image[i]
					a_x=(vx-other.battlecam_x)*other.battlecam_blv
					a_y=(vy-other.battlecam_y)*other.battlecam_blv
					image_xscale=vxs*other.battlecam_blv
					image_yscale=vys*other.battlecam_blv
					image_angle=other.actors_rotate[i]
					image_blend=other.actors_colora[i]
					image_alpha=other.actors_alpha[i]
					image_speed=0
				}

		        gpu_set_blendmode(bm_normal)
				a=sprite_get_number(actors_sprite[i])
			}
			else 
			{
				with(actors_object[i])
				{
					sprite_index=other.actors_sprite[i]
					skeleton_animation_set(other.actors_skeleton_animation[i])
					image_index=other.actors_image[i]
					a_x=(vx-other.battlecam_x)*other.battlecam_blv
					a_y=(vy-other.battlecam_y)*other.battlecam_blv
					image_xscale=vxs*other.battlecam_blv
					image_yscale=vys*other.battlecam_blv
					image_angle=other.actors_rotate[i]
					image_blend=other.actors_colora[i]
					image_alpha=other.actors_alpha[i]
					image_speed=0
				}
		        gpu_set_blendmode(bm_normal)
				a=sprite_get_number(actors_sprite[i])
			}
			actors_image[i]+=actors_image_speed[i]
			if(actors_image[i]>=a&&actors_image_speed[i]>0)
			{
				if(!sprite_exists(actors_combo[i]))
				{
					while(actors_image[i]>=a)
					{
						actors_image[i]-=a
					}
				}
				else
				{
					actors_combo_nj[i]--
					if(actors_combo_nj[i]>0)actors_image[i]-=a
					else
					{
						if(actors_combo[i]!=empty_sprite)
						{
							actors_combo_nj[i]=0
							actors_image[i]=0
							actors_sprite[i]=actors_combo[i]
						}
						else
						{
							actors_reset(i)
							continue;
						}
					}
				}
			}
			else
			{
		        while(actors_image[i]<0)
		        {
		            actors_image[i]+=a
		        }
			}
                
	        var lsx,lsy;
	        lsx=dcos(actors_direction[i])*actors_speed[i]
	        lsy=-dsin(actors_direction[i])*actors_speed[i]
	        actors_x[i]+=lsx
	        actors_y[i]+=lsy
	        if(abs(actors_gravity[i])>0)//点加
	        {
	            lsx+=dcos(actors_gravity_direction[i])*actors_gravity[i]
	            lsy-=dsin(actors_gravity_direction[i])*actors_gravity[i]
	            actors_direction[i]=point_direction(0,0,lsx,lsy)
	            actors_speed[i]=point_distance(0,0,lsx,lsy)
	        }
	        actors_xs[i]+=actors_grow[i]*sign(actors_xs[i])
	        actors_ys[i]+=actors_grow[i]*sign(actors_ys[i])
	        actors_alpha[i]-=actors_disappear[i]
	        actors_rotate[i]+=actors_rotate_speed[i]
	    }
		else
		{
			with(actors_object[i])sprite_index=noone
		}
	}
	battlecam_x+=dcos(battlecam_direction)*battlecam_speed
	battlecam_y-=dsin(battlecam_direction)*battlecam_speed
	//*/
	surface_reset_target()
}