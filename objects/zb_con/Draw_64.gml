var vx,vy,vw,vh,mx,my,i,j,k,l;
mx=device_mouse_x_to_gui(0)
my=device_mouse_y_to_gui(0)
display_set_gui_size(1280,720)
draw_set_alpha(1)
draw_rectangle_colour(0,0,1280,720,0,0,192,0,0)
if(page==-1)
{
    
    vx=52
    vy=64
    vw=270
    vh=64
    for(i=0;i<button_num;i++)
    {
        colora=make_colour_rgb(64,0,255)
        if(i==13)vx+=320
        if(i>1&&i<9&&i!=5&&i!=6&&i!=7)colora=c_gray
        if(mx>=vx&&mx<=vx+vw&&my>=vy&&my<=vy+vh&&cold=false&&colora!=c_gray)
        {
            colora=make_color_rgb(255,255,128)
            if(mouse_check_button_released(mb_left))
            {  
                audio_play_sound(ME00_choose,1,0)
                if(i==12)room_goto(global.nextstage)
                if(i==13)game_restart()
                else 
                {
                    page=i
                    sub_page=0
                    cold=1
                    alarm[0]=5
                }
                if(i==0||i==1||i==5)
                {
                    slot_px(0)
                }
                else if(i==6)
                {
                    slot_px(1)
                }
                else if(i==7)
                {
                    slot_px(2)
                }
                else if(i==9||i==10)
                {
                    save_list_read()
                }
            }
        }
        draw_background(tittle_button,vx,vy)
        draw_set_blend_mode(bm_add)
        draw_background_ext(tittle_button,vx,vy,1,1,0,colora,1)
        draw_set_blend_mode(bm_normal)
        draw_set_font(global.font_m)
        draw_set_halign(fa_center)
        draw_set_valign(fa_middle)
        draw_set_colour(0)
        qtext=button_text[i,0]
        draw_text(vx+vw/2+2,vy+vh/2+2,string_hash_to_newline(qtext))
        draw_set_colour(16777215)
        draw_text(vx+vw/2,vy+vh/2,string_hash_to_newline(qtext))
        vx+=vw+32
        if(i mod 4==3)
        {
            vx=52
            vy+=vh+32
        }
    }    
    //关卡信息展区
    vx=16
    vy=512
    vw=840
    vh=192
    draw_kuang(vx,vy,vx+vw,vy+vh,c_blue)
    qtext=global.task_name+" 过关#总回合数："+string(global.turn_sum)+"#持有金钱："+string(global.money)+"G"
    draw_text_dhk_colour(qtext,vx+8,vy+8,800)
    //天下第一杀人王展区
    vx=1072
    vy=512
    vw=192
    vh=192
    draw_kuang(vx,vy,vx+vw,vy+vh,c_blue)
    draw_sprite(global.pliot_head[killer_queen],0,vx+2,vy+2)
    vx=880
    vy=576
    vw=192
    vh=128
    draw_kuang(vx,vy,vx+vw,vy+vh,c_blue)
    qtext=global.pliot_name[killer_queen]+"#击坠数："+string(global.pliot_kill[killer_queen])
    draw_text_dhk_colour(qtext,vx+8,vy+8,180)
}
//机体
else if(page==0||page==1||page==5||page==6||page==7)
{
    draw_set_font(global.font_m)
    draw_set_halign(fa_center)
    draw_set_valign(fa_middle)
    vx=52
    vy=96
    vw=1176
    vh=592
    draw_kuang(vx,vy,vx+vw,vy+vh,c_blue)
    vh=32
