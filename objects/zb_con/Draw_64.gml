    draw_set_colour(16777215)
    draw_text(vx+vw/2,vy+vh/2,string_hash_to_newline(qtext))
    vx+=vw
    vw=260
    draw_line_width_colour(vx,vy,vx,vy+vh,5,16777215,16777215)
    qtext="附加信息"
    draw_set_colour(0)
    draw_text(vx+vw/2+2,vy+vh/2+2,string_hash_to_newline(qtext))
    draw_set_colour(16777215)
    draw_text(vx+vw/2,vy+vh/2,string_hash_to_newline(qtext))
    vx=52
    vy=96+32
    vw=1176
    draw_line_width_colour(vx,vy,vx+vw,vy,5,16777215,16777215)
    
    vh=64
    vx=52
    vw=1176
    draw_set_font(global.font_s)
    draw_set_halign(fa_center)
    draw_set_valign(fa_middle)
    for(i=0;i<8;i++)
    {
        j=slot_queue[i]+sub_page*8
        rid=-1
        if(j>=0)
        {
            rid=global.base_rid[j]
            pid=global.base_pliot[j]
            if(rid>=0)
            {
                vh=64
                vw=1176
                ax=vx
                ay=vy
                aw=64
                ah=64
                draw_sprite(global.robo_icon[rid],0,ax+aw/2,ay+ah/2)
                ax+=64
                aw=288
                draw_line_width_colour(ax,ay,ax,ay+ah,5,16777215,16777215)
                qtext=global.robo_name[rid]
                draw_set_colour(0)
                draw_text(ax+aw/2+2,ay+ah/2+2,string_hash_to_newline(qtext))
                draw_set_colour(16777215)
                draw_text(ax+aw/2,ay+ah/2,string_hash_to_newline(qtext))
                ax+=aw
                aw=192
                draw_line_width_colour(ax,ay,ax,ay+ah,5,16777215,16777215)
                qtext=global.pliot_name[pid]
                draw_set_colour(0)
                draw_text(ax+aw/2+2,ay+ah/2+2,string_hash_to_newline(qtext))
                draw_set_colour(16777215)
                draw_text(ax+aw/2,ay+ah/2,string_hash_to_newline(qtext))
                ax+=aw
                aw=192
                draw_line_width_colour(ax,ay,ax,ay+ah,5,16777215,16777215)
                qtext=global.robo_hp[rid]*(1+global.base_hp_kai[j]*0.1)
                draw_set_colour(0)
                draw_text(ax+aw/2+2,ay+ah/2+2,string_hash_to_newline(qtext))
                draw_set_colour(16777215)
                draw_text(ax+aw/2,ay+ah/2,string_hash_to_newline(qtext))
                ax+=aw
                aw=192
                draw_line_width_colour(ax,ay,ax,ay+ah,5,16777215,16777215)
                qtext=global.robo_en[rid]*(1+global.base_en_kai[j]*0.1)
                draw_set_colour(0)
                draw_text(ax+aw/2+2,ay+ah/2+2,string_hash_to_newline(qtext))
                draw_set_colour(16777215)
                draw_text(ax+aw/2,ay+ah/2,string_hash_to_newline(qtext))
                ax+=aw
                aw=260
                draw_line_width_colour(ax,ay,ax,ay+ah,5,16777215,16777215)
                if(mx>=vx&&mx<=vx+vw&&my>=vy&&my<=vy+vh&&cold=false&&colora!=c_gray)
                {
                    colora=make_color_rgb(255,255,255)
                    if(mouse_check_button(mb_left))
                        colora=0
                    if(mouse_check_button_released(mb_left))
                    {  
                        audio_play_sound(ME00_choose,1,0)
                        if(page==0)
                        {
                            cold=true
                            mrobo_reset_single(0)
                            create_mrobo_base(j,0,0,0)
                            a=instance_create(0,0,ability_con)
                            a.mrid=0
                            a.mode=0//0=通常,1=攻击
                            a.stand=true
                            a.mapid=0
                        }
                        else if(page==1)
                        {   
                            cold=true
                            a=instance_create(0,0,base_kai_con)
                            a.targetb=j
                        }
                        else if(page==5)
                        {   
                            cold=true
                            a=instance_create(0,0,base_equip_con)
                            a.targetb=j
                        }
                        else if(page==6)
                        {   
                            cold=true
                            a=instance_create(0,0,base_hz_con)
                            a.targetb=j
                        }
                        else if(page==7)
                        {   
                            cold=true
                            a=instance_create(0,0,base_swep_con)
                            a.targetb=j
                        }
                    }
                    draw_set_alpha(0.3)
                    draw_set_colour(colora)
                    draw_rectangle(vx,vy,vx+vw,vy+vh,0)
                    draw_set_alpha(1)
                }
                draw_line_width_colour(vx,vy+vh,vx+vw,vy+vh,5,16777215,16777215)
                vy+=vh
            }
        }
    }
    vx=52
    vy=592+64+16
    vw=32
    vh=32
    for(i=0;i<=min(10,slot_num/8);i++)
    {
        ah=vh
        if(sub_page==i)
            ah=48
        colora=make_colour_rgb(64,0,255)
        if(mx>=vx&&mx<=vx+vw&&my>=vy&&my<=vy+ah&&cold=false&&colora!=c_gray)
        {
            colora=make_color_rgb(255,255,128)
            if(mouse_check_button_released(mb_left))
            {  
                audio_play_sound(ME00_choose,1,0)
                sub_page=i
            }
        }
        draw_kuang(vx,vy,vx+vw,vy+vh,colora)
        draw_set_blend_mode(bm_normal)
        draw_set_font(global.font_m)
        draw_set_halign(fa_center)
        draw_set_valign(fa_middle)
        draw_set_colour(0)
        qtext=string(i+1)
        draw_text(vx+vw/2+2,vy+vh/2+2,string_hash_to_newline(qtext))
        draw_set_colour(16777215)
        draw_text(vx+vw/2,vy+vh/2,string_hash_to_newline(qtext))
        vx+=vw+4
    }
}
