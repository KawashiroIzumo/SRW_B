var dx,dy,vx,vy,vw,vh,dka,ax,ay,bx,by,bw,bh,bflag;
if(drawing)
{
    mov_alarm+=1
    if(mov_alarm>=64)mov_alarm=0
    vx=64
    vw=64
    vy=64
    vh=64
    for(dy=0;dy<global.map_h[mapid];dy+=1)
    {
        for(dx=0;dx<global.map_w[mapid];dx+=1)
        {
            ax=vx+dx*vw
            ay=vy+dy*vh
            if(bfs_map_can_move[dx,dy])
            {
                draw_set_alpha(0.5)
                colora=make_colour_rgb(124+abs(128-mov_alarm*4),255,124+abs(128-mov_alarm*4))
                draw_set_colour(colora);
                draw_rectangle(ax+1,ay+1,ax+vw-1,ay+vh-1,false)
                draw_set_alpha(1)
                draw_set_colour(c_white)
                draw_text_dhk_colour(string(bfs_map_can_movyl[dx,dy]),ax+8,ay+8,0)
            }
        }
    }
    //绘制选中
    if(mode==0||mode==2)
    {
        vx=64
        vw=64
        vy=64
        vh=64
        for(dy=0;dy<global.map_h[mapid];dy+=1)
        {
            for(dx=0;dx<global.map_w[mapid];dx+=1)
            {
                dka=global.map_dtype[mapid,dy*100+dx]
                ax=vx+dx*vw
                ay=vy+dy*vh
                if(mouse_in(ax+1,ay+1,ax+vw-1,ay+vh-1)&&bfs_map_can_move[dx,dy])
                {
                    //draw_sprite(gui_dnd_choose,0,ax,ay)
                    if(mouse_check_button_released(mb_left))
                    {
                        if(mode==2)audio_play_sound(sound11_dff,1,0)
                        global.mrobo_x[mrid]=dx
                        global.mrobo_y[mrid]=dy
                        if(bfs_map_trap[dx,dy]>=100)global.onship=bfs_map_trap[dx,dy]-100
                        with(DND_player)moved=true
                        camera.follow=false
                        instance_destroy()
                    }
                }
            }
        }
        //退出
        if(mouse_check_button_released(mb_right))
        {
            __view_set( e__VW.XView, 0, svx )
            __view_set( e__VW.YView, 0, svy )
            camera.follow=false
            if(mode==2||m2cas>=0)
            {
                for(j=0;j<40;j++)
                {
                    if(global.mrobo_base[m2cas,j]<0)
                    {
                        global.mrobo_base[m2cas,j]=mrid
                        global.mrobo_onship[mrid]=true
                        global.mrobo_x[mrid]=-100
                        global.mrobo_y[mrid]=-100
                        with(DND_player)
                        {
                            onchoose=other.m2cas
                        }
                        break;
                    }
                }
            }
            instance_destroy()
        }
    }
}

