if(ondraw)
{
    if(targetb<0)instance_destroy()
    else if(global.base_rid[targetb]<0)instance_destroy()
    else
    {
        var vx,vy,vw,vh,mx,my,i,j,k,l;
        var rid=global.base_rid[targetb]
        mx=window_mouse_get_x()
        my=window_mouse_get_y()
        draw_set_alpha(1)
        draw_rectangle_colour(0,0,1280,720,0,0,192,0,0)
        vx=52
        vy=40
        vw=1176
        vh=352
        colora=make_colour_rgb(0,0,128)
        draw_kuang(vx,vy,vx+vw,vy+vh,colora)
		var lnum=0
		if(sprite_exists(global.robo_spr_spine[rid]))
		{
			var a=sprite_index;
			sprite_index=global.robo_spr_spine[rid]
			lnum=skeleton_animation_get_frames("stand")
			sprite_index=a
			draw_skeleton(global.robo_spr_spine[rid],"stand","default",jt_image,vx+vw/2,vy+vh/2,0.4,0.4,0,16777215,1)
		}
		else
		{
			lnum=sprite_get_number(global.robo_spr_stand[rid])
			draw_sprite_ext(global.robo_spr_stand[rid],jt_image,vx+vw/2,vy+vh/2,0.4,0.4,0,16777215,1)
		}
        draw_text_dhk_colour(global.robo_name[rid],vx+8,vy+8,0)
        jt_image=(jt_image+1) mod lnum
        vy+=vh
        vh=288
        colora=make_colour_rgb(0,0,255)
        draw_kuang(vx,vy,vx+vw,vy+vh,colora)
        qtext="持有金钱："+string(global.money)+"G#"
        qtext+="改造花费："
        if(global.money<ls_cost)qtext+="[\\c:255]"
        qtext+=string(ls_cost)+"[\\c:16777215]G"
        draw_text_dhk_colour(qtext,vx+8,vy-144,0)
        vy-=64
        vh=48
        aw=192
        ax=vx+8
        if(ls_cost>0)
        {
            colora=make_colour_rgb(0,0,128)
            if(global.money<ls_cost)colora=c_gray
            if(mx>=ax&&mx<=ax+aw&&my>=vy&&my<=vy+vh&&cold=false&&colora!=c_gray)
            {
                colora=make_color_rgb(255,255,128)
                if(mouse_check_button_released(mb_left))
                {  
                    audio_play_sound(SE02_onepoint24,1,0)
                    global.money-=ls_cost
                    global.base_hp_kai[targetb]+=base_ls_kai[0]
                    global.base_en_kai[targetb]+=base_ls_kai[1]
                    global.base_def_kai[targetb]+=base_ls_kai[2]
                    global.base_ac_kai[targetb]+=base_ls_kai[3]
                    global.base_ab_kai[targetb]+=base_ls_kai[4]
                    global.base_wep_kai[targetb]+=base_ls_kai[5]
                    for(i=0;i<6;i+=1)
                        base_ls_kai[i]=0
                    ls_cost=0
                }
            }
            qtext="确认改造"
            draw_kuang(ax,vy,ax+aw,vy+vh,colora)
            draw_set_colour(0)
            draw_text(ax+aw/2+2,vy+vh/2+2,string_hash_to_newline(qtext))
            draw_set_colour(16777215)
            draw_text(ax+aw/2,vy+vh/2,string_hash_to_newline(qtext))
            draw_line_width_colour(ax+aw,vy,ax+aw,vy+vh,5,16777215,16777215)
        }
        vy+=64
        vh=48
        vw=1176
        draw_set_font(global.font_m)
        draw_set_halign(fa_center)
        draw_set_valign(fa_middle)
        gjc=0
        gjm=10
        for(i=0;i<6;i++)
        {
            if(i==0)
            {
                gjc=global.base_hp_kai[targetb]
                gjm=global.robo_hp_mod_max[rid]
                qtext="HP:"+string(floor(global.robo_hp[rid]+500*(base_ls_kai[i]+gjc)))
				if(rid==35)qtext="HP:"+string(floor(global.robo_hp[rid]+100*(base_ls_kai[i]+gjc)))
            }
            else if(i==1)
            {
                gjc=global.base_en_kai[targetb]
                gjm=global.robo_en_mod_max[rid]
                qtext="EN:"+string(floor(global.robo_en[rid]+10*(base_ls_kai[i]+gjc)))
            }
            else if(i==2)
            {
                gjc=global.base_def_kai[targetb]
                gjm=global.robo_def_mod_max[rid]
                qtext="护甲:"+string(floor(global.robo_def[rid]+50*(base_ls_kai[i]+gjc)))
            }
            else if(i==3)
            {
                gjc=global.base_ac_kai[targetb]
                gjm=global.robo_ac_mod_max[rid]
                qtext="机动性:"+string(floor(global.robo_ac[rid]+5*(base_ls_kai[i]+gjc)))
            }
            else if(i==4)
            {
                gjc=global.base_ab_kai[targetb]
                gjm=global.robo_ab_mod_max[rid]
                qtext="照准:"+string(floor(global.robo_ab[rid]+5*(base_ls_kai[i]+gjc)))
            }
            else
            {
                gjc=global.base_wep_kai[targetb]
                gjm=global.robo_wep_mod_max[rid]
                qtext="武器:"+string(gjc+base_ls_kai[i])+"段"  
            }
            ax=vx
            aw=256
            draw_set_colour(0)
            draw_text(ax+aw/2+2,vy+vh/2+2,string_hash_to_newline(qtext))
            draw_set_colour(16777215)
            draw_text(ax+aw/2,vy+vh/2,string_hash_to_newline(qtext))
            draw_line_width_colour(ax+aw,vy,ax+aw,vy+vh,5,16777215,16777215)
            ax+=aw+32
            aw=36*gjm+4
            draw_set_colour(0)
            draw_set_alpha(.5)
            draw_rectangle(ax,vy+4,ax+aw,vy+vh-4,0)
            draw_set_colour(16777215)
            draw_set_alpha(1)
            draw_rectangle(ax,vy+4,ax+aw,vy+vh-4,1)
            draw_line_width_colour(ax+aw,vy,ax+aw,vy+vh,5,16777215,16777215)
            ax+=4
            aw=32
            for(j=0;j<gjc+base_ls_kai[i];j++)
            {
                colora=c_white
                if(j>=gjc)colora=c_yellow
                draw_rectangle_colour(ax,vy+6,ax+aw,vy+vh-6,colora,colora,c_gray,c_gray,0)
                ax+=aw+4
            }
            ax=vx+768
            aw=128
            colora=make_colour_rgb(0,0,128)
            if(gjc+base_ls_kai[i]>=gjm)colora=c_gray
            if(mx>=ax&&mx<=ax+aw&&my>=vy&&my<=vy+vh&&cold=false&&colora!=c_gray)
            {
                colora=make_color_rgb(255,255,128)
                if(mouse_check_button_released(mb_left))
                {  
                    audio_play_sound(ME00_choose,1,0)
                    ls_cost+=global.cost_kai[i,gjc+base_ls_kai[i]]
                    base_ls_kai[i]++
                }
            }
            qtext="升级"
            draw_kuang(ax,vy,ax+aw,vy+vh,colora)
            draw_set_colour(0)
            draw_text(ax+aw/2+2,vy+vh/2+2,string_hash_to_newline(qtext))
            draw_set_colour(16777215)
            draw_text(ax+aw/2,vy+vh/2,string_hash_to_newline(qtext))
            draw_line_width_colour(ax+aw,vy,ax+aw,vy+vh,5,16777215,16777215)
            
            
            ax+=aw+8
            aw=128
            colora=make_colour_rgb(0,0,128)
            if(base_ls_kai[i]<=0)colora=c_gray
            qtext="降级"
            if(mx>=ax&&mx<=ax+aw&&my>=vy&&my<=vy+vh&&cold=false&&colora!=c_gray)
            {
                colora=make_color_rgb(255,255,128)
                if(mouse_check_button_released(mb_left))
                {  
                    audio_play_sound(ME00_choose,1,0)
                    base_ls_kai[i]--
                    ls_cost-=global.cost_kai[i,gjc+base_ls_kai[i]]
                }
            }
            draw_kuang(ax,vy,ax+aw,vy+vh,colora)
            draw_set_colour(0)
            draw_text(ax+aw/2+2,vy+vh/2+2,string_hash_to_newline(qtext))
            draw_set_colour(16777215)
            draw_text(ax+aw/2,vy+vh/2,string_hash_to_newline(qtext))
            draw_line_width_colour(ax+aw,vy,ax+aw,vy+vh,5,16777215,16777215)
            
            
            draw_line_width_colour(vx,vy+vh,vx+vw,vy+vh,5,16777215,16777215)
            vy+=vh
        }
    }
    if(!cold&&mouse_check_button_released(mb_right))
    {
        instance_destroy()
    }
}

