	//==============================
	i=15//霍青娥
		#region
	    j=0
	    global.pliot_open_text[i,j]="这位道友，贫道看你天庭饱满，紫光透体，绝非凡人啊！可惜若无人指点。怕此生结丹无望。"
	    j=1
	    global.pliot_open_text[i,j]="道友请留步！"
	    j=2
	    global.pliot_open_text[i,j]="贫道霍青娥，在元婴期这一阶层上，是无敌的！"
	    j=3
	    global.pliot_open_text[i,j]="你不死，不代表你有本事，只是贫道还没玩够！"
	    global.pliot_open_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_s_text[i,j]="不巧的是，贫道正好也是一个护体法术方面的天才。"
	    j=1
	    global.pliot_hurt_s_text[i,j]="想当年，在山西省，我们霍家是三大世家之一。"
	    j=2
	    global.pliot_hurt_s_text[i,j]="我命由我，不由天。"
	    j=3
	    global.pliot_hurt_s_text[i,j]="你的内息已经乱了。"
	    global.pliot_hurt_s_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_m_text[i,j]="此子恐怖如斯，断不能留！"
	    j=1
	    global.pliot_hurt_m_text[i,j]="天下宝物有能者居之，道友何不放弃这场争端呢？"
	    j=2
	    global.pliot_hurt_m_text[i,j]="年纪轻轻居然有这番修为，贫道要想个办法把他赚进神灵庙。"
	    global.pliot_hurt_m_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_l_text[i,j]="三十年河东，三十年河西，莫欺少女穷！"
	    j=1
	    global.pliot_hurt_l_text[i,j]="可惜，你依旧是画中人……"
	    j=2
	    global.pliot_hurt_l_text[i,j]="我若要有，天不可无。我若要无，天不许有！"
	    global.pliot_hurt_l_num[i]=j+1
    
	    j=0
	    global.pliot_dodge_text[i,j]="你的心已经乱了。"
	    j=1
	    global.pliot_dodge_text[i,j]="你能跟上白帝圣剑的速度吗？"
	    j=2
	    global.pliot_dodge_text[i,j]="如果只是麒麟游的话，贫道倒是能模仿一二。"
	    global.pliot_dodge_num[i]=j+1
    
	    j=0
	    global.pliot_dead_text[i,j]="无妨，总得给后生小辈一些表现的空间。"
	    j=1
	    global.pliot_dead_text[i,j]="那么，贫道在此退场。"
	    j=2
	    global.pliot_dead_text[i,j]="你胜得了贫道一招，已经很不错了，贫道过几日再来讨教。"
	    global.pliot_dead_num[i]=j+1
    
	    j=0
	    global.pliot_wep_text[i,j]="剑来！"
	    j=1
	    global.pliot_wep_text[i,j]="天不生我霍青娥，管教万古如长夜。"
    
	    j=50
	    global.pliot_wep_text[i,j]="此剑，名为【巨阙】。领教一下它的威力吧。"
	    j=51
	    global.pliot_wep_text[i,j]="此铲，名为【摇光】，让贫道来给你开个洞。"
	    j=52
	    global.pliot_wep_text[i,j]="此枪，名为【天市】，时代已经变了。"
	    j=53
	    global.pliot_wep_text[i,j]="此锄，名为【开阳】，农学乃立国之本，贫道要让你体会体会。"
	    j=54
	    global.pliot_wep_text[i,j]="御枪术，天钱乱击！"
	    j=55
	    global.pliot_wep_text[i,j]="这就是神灵派基础剑法习练一百年的成果！"
		j=56
	    global.pliot_wep_text[i,j]="此物乃何物？为何贫道也能驾驭此物？道友莫非作弊了？"
		j=57
	    global.pliot_wep_text[i,j]="刀，终究是刀，但决定刀剑威力的却是持刀的人。"
		j=58
	    global.pliot_wep_text[i,j]="太上老君急急如律令！RUA!"
		j=59
	    global.pliot_wep_text[i,j]="痴儿！给贫道从《武经总要》第一页重新学起！"
		j=60
		global.pliot_wep_text[i,j]="西洋的魔法，贫道也略知一二，不过是魔杖这种法宝，只需要以真元激发它即可。"
	    global.pliot_wep_num[i]=j+1
		#endregion
