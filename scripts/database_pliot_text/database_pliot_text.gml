	    j=1
	    global.pliot_hurt_m_text[i,j]="这是什么武器"
	    j=2
	    global.pliot_hurt_m_text[i,j]="……多少是有个铁壳子罩着我"
	    global.pliot_hurt_m_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_l_text[i,j]="嗨呀，简直是鸡蛋碰石头。"
	    j=1
	    global.pliot_hurt_l_text[i,j]="我没死……？"
	    j=2
	    global.pliot_hurt_l_text[i,j]="好痛啊！撞到头了！"
