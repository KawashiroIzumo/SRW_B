	        global.pliot_hurt_l_face[i,j]=0
	    global.pliot_hurt_l_num[i]=j+1
    
	    j=0
	    global.pliot_dodge_text[i,j]="你以为我是为了什么而研发出女皇水晶推进器的？"
	    global.pliot_dodge_name[i,j]="拉托妮9号"
	        global.pliot_dodge_voice[i,j]=sound36_piano2
	        global.pliot_dodge_head[i,j]=thh09_chiroB
	        global.pliot_dodge_face[i,j]=0
	    j=1
	    global.pliot_dodge_text[i,j]="哼，完全听不懂这货在说什么。"
	    j=2
	    global.pliot_dodge_text[i,j]="另一个我啊，你太慢啦，这不是差点就命中了吗。"
	    global.pliot_dodge_num[i]=j+1
    
	    j=0
	    global.pliot_dead_text[i,j]="肚子被打穿了一个大洞啊……不过死不了吗？哼，只有这个时候我才庆幸自己是强化儿童。"
	    global.pliot_dead_name[i,j]="拉托妮9号"
	        global.pliot_dead_voice[i,j]=sound36_piano2
	        global.pliot_dead_head[i,j]=thh09_chiroB
	        global.pliot_dead_face[i,j]=0
	    j=1
	    global.pliot_dead_text[i,j]="拜拜，明天再来找你玩！"
	    j=2
	    global.pliot_dead_text[i,j]="开什么玩笑啊～"
	    global.pliot_dead_num[i]=j+1
    
	    j=0
	    global.pliot_wep_text[i,j]="键盘拉出来，然后你把手让给我，然后用脚踩踏板把冰屑全部撒出去，不需要瞄准。"
	    global.pliot_wep_name[i,j]="拉托妮9号"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh09_chiroB
	        global.pliot_wep_face[i,j]=0
	    j=1
	    global.pliot_wep_text[i,j]="我的手自己动起来了……就是这个时候吧？踩了！"

	    j=2
	    global.pliot_wep_text[i,j]="其实我在想，如果我吃完饭，然后把手让给你，然后你给我擦嘴是一种什么感受"
    
	    j=3
	    global.pliot_wep_text[i,j]="这个时候就别装第一次啦！我们这样都多少年了！"
	    global.pliot_wep_name[i,j]="拉托妮9号"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh09_chiroB
	        global.pliot_wep_face[i,j]=0
    
	    j=4
	    global.pliot_wep_text[i,j]="……按你的性格，这时候是在想擦屁股的事情吧？……"
	    global.pliot_wep_name[i,j]="拉托妮9号"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh09_chiroB
	        global.pliot_wep_face[i,j]=0
        
	    j=5
	    global.pliot_wep_text[i,j]="问号没有消失！骇入成功了！现在开始在问号位置制冰！"
	    global.pliot_wep_name[i,j]="拉托妮9号"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh09_chiroB
	        global.pliot_wep_face[i,j]=0
    
	    j=6
	    global.pliot_wep_text[i,j]="剑型制冰机！！！"
    
	    j=7
	    global.pliot_wep_text[i,j]="哦啦哦啦！像做英吉利牛肉丸一样打碎他们吧！"
    
	    j=8
	    global.pliot_wep_text[i,j]="……你知道我用脚打字来稳定冷冻机的出力有多累吗？"
	    global.pliot_wep_name[i,j]="拉托妮9号"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh09_chiroB
	        global.pliot_wep_face[i,j]=0
    
	    j=9
	    global.pliot_wep_text[i,j]="有道理啊，那么打完这场之后我得在辽宁号食堂点一份朝鲜冷面来犒劳你啦！"
    
	    j=10
	    global.pliot_wep_text[i,j]="……我吃不就等于你吃吗？？其实是你想吃吧！"
	    global.pliot_wep_name[i,j]="拉托妮9号"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh09_chiroB
	        global.pliot_wep_face[i,j]=0
        
	    j=50
	    global.pliot_wep_text[i,j]="每次看到都觉得这个举升系统超厉害的耶！不愧是另一个我啊。"
	    j=51
	    global.pliot_wep_text[i,j]="前面那位，不要干涉我清理垃圾好吗？"
	    global.pliot_wep_name[i,j]="拉托妮9号"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh09_chiroB
	        global.pliot_wep_face[i,j]=0
	    j=52
	    global.pliot_wep_text[i,j]="好好地瞄准……算了，无所谓了。"
	    j=53
	    global.pliot_wep_text[i,j]="这种垃圾回收的路数非常眼熟啊，不会是真香做出来的吧。"
	    global.pliot_wep_name[i,j]="拉托妮9号"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh09_chiroB
	        global.pliot_wep_face[i,j]=0
	    j=54
	    global.pliot_wep_text[i,j]="另一个我！在吗？为什么缩在后面放冷枪？"
	    j=55
	    global.pliot_wep_text[i,j]="另一个我！听话啊！不要突然冲出去啊你这个笨蛋！"
	    global.pliot_wep_name[i,j]="拉托妮9号"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh09_chiroB
	        global.pliot_wep_face[i,j]=0
		j=56
	    global.pliot_wep_text[i,j]="？？？我为什么能用黑桃迫击炮的？？你作弊了吧？"
		j=57
	    global.pliot_wep_text[i,j]="这次就让我来负责突击吧，马刀的话，我也能……！"
		global.pliot_wep_name[i,j]="拉托妮9号"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh09_chiroB
	        global.pliot_wep_face[i,j]=0
		j=58
	    global.pliot_wep_text[i,j]="RUA!"
		j=59
	    global.pliot_wep_text[i,j]="哈哈哈哈，古董配古董，真是合适啊！"
		j=60
		global.pliot_wep_text[i,j]="阿瓦达索命！钻心剜骨！神锋无影！昏昏倒地！除你武器！力松劲泄！"
	    global.pliot_wep_num[i]=j+1
		#endregion
