	    global.pliot_hurt_s_text[i,j]="哦哦哦好险是避开了要害部位。"
	    j=2
	    global.pliot_hurt_s_text[i,j]="好菜啊"
	    j=3
	    global.pliot_hurt_s_text[i,j]="这个要我自己修吧？"
