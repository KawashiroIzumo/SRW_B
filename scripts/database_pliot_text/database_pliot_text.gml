	i=16//鸡瘟兵
		#region
	    j=0
	    global.pliot_open_text[i,j]="是吉翁，不是鸡瘟！"
	    j=1
	    global.pliot_open_text[i,j]="不要小看职业军人啊！"
	    j=2
	    global.pliot_open_text[i,j]="平衡做的吊差，什么烂MS，该死的阿纳海姆"
