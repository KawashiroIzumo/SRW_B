/// @description database_pliot_text()
function database_pliot_text() {
	var i,j;
	for(i=0;i<global.pliot_num;i++)
	{
	    for(j=0;j<32;j++)
	    {
	        global.pliot_open_text[i,j]=""//文字
	        global.pliot_open_name[i,j]=global.pliot_name[i]//名称
	        global.pliot_open_voice[i,j]=sound36_piano2//语音，未实装
	        global.pliot_open_head[i,j]=global.pliot_head[i]//头像
			global.pliot_open_face[i,j]=0//头像的表情
	        global.pliot_open_ignore[i,j]=noone//筛选条件
	        global.pliot_open_ignore_argument[i,j]=0//筛选条件的参数
	        
	    }
	    global.pliot_open_num[i]=0
	    for(j=0;j<16;j++)
	    {
	        global.pliot_hurt_s_text[i,j]=""
	        global.pliot_hurt_s_name[i,j]=global.pliot_name[i]
	        global.pliot_hurt_s_voice[i,j]=sound36_piano2
	        global.pliot_hurt_s_head[i,j]=global.pliot_head[i]
	        global.pliot_hurt_s_face[i,j]=0
			global.pliot_hurt_s_ignore[i,j]=noone//筛选条件
	        global.pliot_hurt_s_ignore_argument[i,j]=0//筛选条件的参数
	    }
	    global.pliot_hurt_s_num[i]=0
	    for(j=0;j<16;j++)
	    {
	        global.pliot_hurt_m_text[i,j]=""
	        global.pliot_hurt_m_name[i,j]=global.pliot_name[i]
	        global.pliot_hurt_m_voice[i,j]=sound36_piano2
	        global.pliot_hurt_m_head[i,j]=global.pliot_head[i]
	        global.pliot_hurt_m_face[i,j]=0
			global.pliot_hurt_m_ignore[i,j]=noone//筛选条件
	        global.pliot_hurt_m_ignore_argument[i,j]=0//筛选条件的参数
	    }
	    global.pliot_hurt_m_num[i]=0
	    for(j=0;j<16;j++)
	    {
	        global.pliot_hurt_l_text[i,j]=""
	        global.pliot_hurt_l_name[i,j]=global.pliot_name[i]
	        global.pliot_hurt_l_voice[i,j]=sound36_piano2
	        global.pliot_hurt_l_head[i,j]=global.pliot_head[i]
	        global.pliot_hurt_l_face[i,j]=0
			global.pliot_hurt_l_ignore[i,j]=noone//筛选条件
	        global.pliot_hurt_l_ignore_argument[i,j]=0//筛选条件的参数
	    }
	    global.pliot_hurt_l_num[i]=0
	    for(j=0;j<16;j++)
	    {
	        global.pliot_dodge_text[i,j]=""
	        global.pliot_dodge_name[i,j]=global.pliot_name[i]
	        global.pliot_dodge_voice[i,j]=sound36_piano2
	        global.pliot_dodge_head[i,j]=global.pliot_head[i]
	        global.pliot_dodge_face[i,j]=0
			global.pliot_dodge_ignore[i,j]=noone//筛选条件
	        global.pliot_dodge_ignore_argument[i,j]=0//筛选条件的参数
	    }
	    global.pliot_dodge_num[i]=0
	    for(j=0;j<16;j++)
	    {
	        global.pliot_dead_text[i,j]=""
	        global.pliot_dead_name[i,j]=global.pliot_name[i]
	        global.pliot_dead_voice[i,j]=sound36_piano2
	        global.pliot_dead_head[i,j]=global.pliot_head[i]
	        global.pliot_dead_face[i,j]=0
			global.pliot_dead_ignore[i,j]=noone//筛选条件
	        global.pliot_dead_ignore_argument[i,j]=0//筛选条件的参数
	    }
	    global.pliot_dead_num[i]=0
	    for(j=0;j<128;j++)
	    {
	        global.pliot_wep_text[i,j]=""
	        global.pliot_wep_name[i,j]=global.pliot_name[i]
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=global.pliot_head[i]
	        global.pliot_wep_face[i,j]=0
	    }
	    global.pliot_wep_num[i]=0
	}
	//==============================
	i=0//波澜哥
		#region
	    j=0
	    global.pliot_open_text[i,j]="对方也是高达型机体吗？"
	    j=1
	    global.pliot_open_text[i,j]="不行，凭这台破烂机体打得过谁啊！"
	    j=2
	    global.pliot_open_text[i,j]="这台波澜高达，不是战斗用的！"
	    j=3
	    global.pliot_open_text[i,j]="我只是个文艺兵，怎么会遇到这种事？"
	    global.pliot_open_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_s_text[i,j]="损伤轻微，是模拟弹吗？"
	    j=1
	    global.pliot_hurt_s_text[i,j]="虽然机体破破烂烂，但是装甲果然还是正常水平。"
	    j=2
	    global.pliot_hurt_s_text[i,j]="超高张力钢……不对，没有偷工减料，所以这台机体的材质就是传说中的高达尼姆合金。"
	    j=3
	    global.pliot_hurt_s_text[i,j]="好厉害啊，高达。"
	    global.pliot_hurt_s_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_m_text[i,j]="危险！还好装甲撑得住。"
	    j=1
	    global.pliot_hurt_m_text[i,j]="外甲已经破破烂烂的了，又要挨韩老师的骂啦。"
	    j=2
	    global.pliot_hurt_m_text[i,j]="我真是很嫌弃这台机的装甲——什么高达尼玛合金啊。"
	    global.pliot_hurt_m_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_l_text[i,j]="我还以为我要死了。"
	    j=1
	    global.pliot_hurt_l_text[i,j]="救命啊！我只是文艺兵啊！"
	    j=2
	    global.pliot_hurt_l_text[i,j]="可以预见到的是整备班看我的眼神。"
	    global.pliot_hurt_l_num[i]=j+1
    
	    j=0
	    global.pliot_dodge_text[i,j]="只要活用高达的喷射背包的话！"
	    j=1
	    global.pliot_dodge_text[i,j]="太慢了！根本不在节奏上。"
	    j=2
	    global.pliot_dodge_text[i,j]="你应该调整一下弹道的。"
	    global.pliot_dodge_num[i]=j+1
    
	    j=0
	    global.pliot_dead_text[i,j]="再见美好的世界,,,"
	    j=1
	    global.pliot_dead_text[i,j]="你嫌弃波澜，揉碎了我噢噢噢噢"
	    j=2
	    global.pliot_dead_text[i,j]="对我俩~抬股攻屁！"
	    global.pliot_dead_num[i]=j+1
    
	    j=0
	    global.pliot_wep_text[i,j]="我要——弹您尻！"
	    j=1
	    global.pliot_wep_text[i,j]="使用这个声音反应系统，掀起一场波澜吧！高达！"
	    j=2
	    global.pliot_wep_text[i,j]="这个武器是通向胜利的号角！骚老师，回应我吧！"
	    j=3
	    global.pliot_wep_text[i,j]="虽然德斯步枪的威力开大了容易又变成破烂……"
	    j=4
	    global.pliot_wep_text[i,j]="这只手是从高达武斗大会的废品里面捡到的，可以当作熔断钳，于是吃我这招吧！"
		j=5
		global.pliot_wep_text[i,j]="这台机体的反应炉大得出奇……那么，只要适当提升光束喷枪的功率的话！"
		j=6
		global.pliot_wep_text[i,j]="哦哦哦！南拳妈妈！"
		j=7
		global.pliot_wep_text[i,j]="哦哦哦！霍元甲！"
		
	    j=50
	    global.pliot_wep_text[i,j]="让我来告诉你我背着这么大的货柜的理由吧！"
	    j=51
	    global.pliot_wep_text[i,j]="啊，得小心点用，毕竟在小行星挖坑还需要这个。"
	    j=52
	    global.pliot_wep_text[i,j]="联邦军不会发现我捡了他们的残次品！"
	    j=53
	    global.pliot_wep_text[i,j]="为什么货柜里面会有锄头？而且这个08农业小队很让人在意啊。"
	    j=54
	    global.pliot_wep_text[i,j]="你 掀起波澜 让我心碎~"
	    j=55
	    global.pliot_wep_text[i,j]="近战对我有利……啊，混职业战队时候的黑话出来了。"
	    j=56
	    global.pliot_wep_text[i,j]="？？？我为什么能用黑桃迫击炮的？？你作弊了吧？"
		j=57
	    global.pliot_wep_text[i,j]="啊这刀，看起来好贵的样子"
		j=58
	    global.pliot_wep_text[i,j]="RUA!"
		j=59
	    global.pliot_wep_text[i,j]="垃圾场好像有很多这个枪的样子，是很不好用吗？"
		j=60
	    global.pliot_wep_text[i,j]="比黄昏更加昏暗，比鲜血更加鲜红，时光不断流逝，您的力量长存，籍住您的名义，我在黑暗中发誓，所有阻塞在我面前的愚蠢之物，凭您我的力量，必致灭亡"
	    global.pliot_wep_num[i]=j+1
		#endregion
	//==============================
	i=1//铁十字兵
		#region
	    j=0
	    global.pliot_open_text[i,j]="啊啊，高达，是高达啊！"
		global.pliot_open_ignore[i,j]=p_ignore00_is_gundam
	    j=1
	    global.pliot_open_text[i,j]="不要小看职业军人啊！"
	    j=2
	    global.pliot_open_text[i,j]="现在正式开始高达捕获作战！"
		global.pliot_open_ignore[i,j]=p_ignore00_is_gundam
	    j=3
	    global.pliot_open_text[i,j]="我未尝一败，也未获得一次胜利。"
	    global.pliot_open_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_s_text[i,j]="损伤轻微，还能继续战斗。"
	    j=1
	    global.pliot_hurt_s_text[i,j]="英雄也不过如此。"
	    j=2
	    global.pliot_hurt_s_text[i,j]="好菜啊"
	    j=3
	    global.pliot_hurt_s_text[i,j]="腿不是装饰，下面的小人物不会懂的。"
	    global.pliot_hurt_s_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_m_text[i,j]="损伤程度适中，开始损管。"
	    j=1
	    global.pliot_hurt_m_text[i,j]="不错嘛，但是！"
	    j=2
	    global.pliot_hurt_m_text[i,j]="我还能继续！我还能继续！"
	    global.pliot_hurt_m_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_l_text[i,j]="是不是开始计划逃跑比较好呢。"
	    j=1
	    global.pliot_hurt_l_text[i,j]="机体大破，哪里可以逃走……"
	    j=2
	    global.pliot_hurt_l_text[i,j]="这就是我的逃跑路线！"
	    global.pliot_hurt_l_num[i]=j+1
    
	    j=0
	    global.pliot_dodge_text[i,j]="得过且过吧。"
	    j=1
	    global.pliot_dodge_text[i,j]="太直了！"
	    j=2
	    global.pliot_dodge_text[i,j]="不要小看军人啊！"
	    global.pliot_dodge_num[i]=j+1
    
	    j=0
	    global.pliot_dead_text[i,j]="灭火！灭火！啊啊啊啊啊"
	    j=1
	    global.pliot_dead_text[i,j]="那么我就把你的灵魂带走吧……说笑的啦"
	    j=2
	    global.pliot_dead_text[i,j]="也许我一开始就不该选这份工作"
	    global.pliot_dead_num[i]=j+1
    
	    j=0
	    global.pliot_wep_text[i,j]="尝尝我的光束军刀"
	    j=1
	    global.pliot_wep_text[i,j]="尝尝我的光束军刀！#啊，拿错了"
	    j=2
	    global.pliot_wep_text[i,j]="盾牌内藏电热贯钉，预热开始"
		j=3
	    global.pliot_wep_text[i,j]="感觉真不好，我们居然在用修房子的工具打仗。"
		j=4
	    global.pliot_wep_text[i,j]="这让我想起了我在拆迁队的日子，被这拳头打到了可不是好玩的。"
	    global.pliot_wep_num[i]=j+1
		#endregion
	//==============================
	i=2//灵梦
		#region
	    j=0
	    global.pliot_open_text[i,j]="看来，不是随便打打就能结束的局面呢。"
	    global.pliot_open_voice[i,j]=voice00_gundamsyoi
	    j=1
	    global.pliot_open_text[i,j]="为什么本姑娘非得跑到这种阴暗潮湿的地方来啊？"
	    global.pliot_open_voice[i,j]=voice01_zyjr
	    j=2
	    global.pliot_open_text[i,j]="是敌人么。"
	    global.pliot_open_voice[i,j]=voice02_msbooms
	    j=3
	    global.pliot_open_text[i,j]="下级妖怪吗？宰了就好，也许尸体的气味能把主人给引出来。"
	    global.pliot_open_voice[i,j]=voice03_makete
	    global.pliot_open_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_s_text[i,j]="虽说从刚才开始就感觉热……确实是有点口渴了。"
	    j=1
	    global.pliot_hurt_s_text[i,j]="真麻烦，把对手统统打倒后早点回去算了。"
	    j=2
	    global.pliot_hurt_s_text[i,j]="多有意思啊！"
	    j=3
	    global.pliot_hurt_s_text[i,j]="哎呀，我也算是人类的宝物呢~"
	    global.pliot_hurt_s_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_m_text[i,j]="怀旧怪谈的话题到此为止！你稍微让开一点……"
	    j=1
	    global.pliot_hurt_m_text[i,j]="总感觉，充满遗憾的气氛呢……"
	    j=2
	    global.pliot_hurt_m_text[i,j]="没时间去管这些杂鱼妖怪。顶下这些攻击就好。"
	    global.pliot_hurt_m_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_l_text[i,j]="数量太多了，没法全部都治退！"
	    j=1
	    global.pliot_hurt_l_text[i,j]="妖怪啥的赶快给我坠落多好……"
	    j=2
	    global.pliot_hurt_l_text[i,j]="你说什么我完全听不懂啊！"
	    global.pliot_hurt_l_num[i]=j+1
    
	    j=0
	    global.pliot_dodge_text[i,j]="你看看这不是什么都没有吗！"
	    j=1
	    global.pliot_dodge_text[i,j]="逗笑的？"
	    j=2
	    global.pliot_dodge_text[i,j]="我自认为修行不浅来着啊！"
	    global.pliot_dodge_num[i]=j+1
    
	    j=0
	    global.pliot_dead_text[i,j]="忘记带上那重要的东西。留在神社里了……"
	    j=1
	    global.pliot_dead_text[i,j]="嘛，是人类也好不是人类也好都无所谓了。"
	    j=2
	    global.pliot_dead_text[i,j]="我不要到了明天还是夜晚啊。"
	    global.pliot_dead_num[i]=j+1
    
	    j=0
	    global.pliot_wep_text[i,j]="牵制射击，总之先把你逼到死角。"
	    j=1
	    global.pliot_wep_text[i,j]="还没完哦！"
	    j=2
	    global.pliot_wep_text[i,j]="我偶尔也会使用这样的锐器的啦，说起来这光束钉还是小伞做给我的。"
	    j=3
	    global.pliot_wep_text[i,j]="文，我要使用明珠暗投，准备变为穿波机模式。"
	    j=4
	    global.pliot_wep_text[i,j]="了解，我会在阴阳玉成型后开始变形。"
	        global.pliot_wep_name[i,j]="文"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh07_aya
	        global.pliot_wep_face[i,j]=0
	    j=5
	    global.pliot_wep_text[i,j]="让你掉进结界的缝隙中！"
	    global.pliot_wep_num[i]=j+1
	    j=6
	    global.pliot_wep_text[i,j]="看来是确确实实的，有异变正在发生。"
	    j=7
	    global.pliot_wep_text[i,j]="真是不像话。"
	    j=8
	    global.pliot_wep_text[i,j]="萃香，我要准备使用鬼神阴阳玉，从货舱中把高压缩的那个递给我。"
	    j=9
	    global.pliot_wep_text[i,j]="了解，可能会有点颠簸"
	        global.pliot_wep_name[i,j]="萃香"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh04_suika
	        global.pliot_wep_face[i,j]=0
	    j=10
	    global.pliot_wep_text[i,j]="这下可省得花时间去瞄准了，干净利落地收拾掉吧！"
	    j=11
	    global.pliot_wep_text[i,j]="完蛋，这里是哪儿啊！"
	        global.pliot_wep_name[i,j]="萃香"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh04_suika
	        global.pliot_wep_face[i,j]=0
	    j=12
	    global.pliot_wep_text[i,j]="啊？算了，只要之后追上去就好了吧？追上去就好。"
	    j=13
	    global.pliot_wep_text[i,j]="我妈当年被称为红色扫把星，可不是浪得虚名的！"
	    j=14
	    global.pliot_wep_text[i,j]="机体的性能差距不是决定胜负的唯一要素，就让我来告诉你吧！"
	    j=15
	    global.pliot_wep_text[i,j]="这种战术动作……虽然不想承认，这都是我妈年轻的时候犯下的错啊。"
		j=16
	    global.pliot_wep_text[i,j]="紫，你的小队呢？叫她们出来援护我！"
		j=17
	    global.pliot_wep_text[i,j]="她们已经集结完毕了。"
	        global.pliot_wep_name[i,j]="紫"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh18_yukari
	        global.pliot_wep_face[i,j]=0
		j=18
	    global.pliot_wep_text[i,j]="好了，准备好了吗？"
	        global.pliot_wep_name[i,j]="紫"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh18_yukari
	        global.pliot_wep_face[i,j]=0
		j=19
	    global.pliot_wep_text[i,j]="是！"
	        global.pliot_wep_name[i,j]="蓝"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh20_lan
	        global.pliot_wep_face[i,j]=0
		j=20
	    global.pliot_wep_text[i,j]="猫霸的状况非常良好！"
	        global.pliot_wep_name[i,j]="橙"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh19_chen
	        global.pliot_wep_face[i,j]=0
		j=21
