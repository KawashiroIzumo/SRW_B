	i=13//针妙丸
		#region
	    j=0
	    global.pliot_open_text[i,j]="[\\shock:1]有点晃啊[\\shock:0]，让仓鼠笼里面的1/100级小人们加把劲呗？"
	    j=1
	    global.pliot_open_text[i,j]="正邪！本宫早就告诉过你了！不要在舰桥上吃老婆饼这种掉渣零食啊！1/144级小人会捡来吃的！"
	    j=2
	    global.pliot_open_text[i,j]="[\\ag:180]好无聊啊，殿下，放部电影来看呗？"
	    global.pliot_open_name[i,j]="鬼人正邪"
	        global.pliot_open_voice[i,j]=sound36_piano2
	        global.pliot_open_head[i,j]=thh30_seija
	        global.pliot_open_face[i,j]=0
	    j=3
	    global.pliot_open_text[i,j]="[\\shock:1]正邪！不是给你装了窗帘吗！居然在用1/144小人擦嘴！[\\shock:0]"
	    global.pliot_open_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_s_text[i,j]="宇宙石头制作的城墙，三层宇宙糯米包浆，根本就不是这种攻击能够撼动的。"
	    j=1
	    global.pliot_hurt_s_text[i,j]="窗户遭到直击……啊，原来是几个1/60小人在开窗透气……小问题！"
	    j=2
	    global.pliot_hurt_s_text[i,j]="[\\ag:180]殿下，你的手办收藏室有大震动啊，玻璃柜真的挺得住吗？"
	    global.pliot_hurt_s_name[i,j]="鬼人正邪"
	        global.pliot_hurt_s_voice[i,j]=sound36_piano2
	        global.pliot_hurt_s_head[i,j]=thh30_seija
	        global.pliot_hurt_s_face[i,j]=0
	    j=3
	    global.pliot_hurt_s_text[i,j]="这种程度都不用钻进碗里。"
	    global.pliot_hurt_s_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_m_text[i,j]="宇宙石头随处可见，不过是打掉了几个而已，维修队快上，修就完事了。"
	    j=1
	    global.pliot_hurt_m_text[i,j]="正邪，拿本宫的锤子来。"
	    j=2
	    global.pliot_hurt_m_text[i,j]="[\\ag:180]完球，公主殿下要认真打咯。"
	    global.pliot_hurt_m_name[i,j]="鬼人正邪"
	        global.pliot_hurt_m_voice[i,j]=sound36_piano2
	        global.pliot_hurt_m_head[i,j]=thh30_seija
	        global.pliot_hurt_m_face[i,j]=0
	    global.pliot_hurt_m_num[i]=j+1
    
	    j=0
	    global.pliot_hurt_l_text[i,j]="[\\ag:180]竟敢小看我！明明只是个杂鱼！"
	    global.pliot_hurt_l_name[i,j]="鬼人正邪"
	        global.pliot_hurt_l_voice[i,j]=sound36_piano2
	        global.pliot_hurt_l_head[i,j]=thh30_seija
	        global.pliot_hurt_l_face[i,j]=0
	    j=1
	    global.pliot_hurt_l_text[i,j]="正邪，后撤吧。留得青山在，不怕没柴烧，对不对？"
	    j=2
	    global.pliot_hurt_l_text[i,j]="……用战舰作为友军的盾牌！"
	    global.pliot_hurt_l_num[i]=j+1
    
	    j=0
	    global.pliot_dodge_text[i,j]="人类也不是一无是处呢。啊，这一招除外，连战舰都打不中的招式确实一无是处。"
	    j=1
	    global.pliot_dodge_text[i,j]="[\\ag:180]这种弹幕我就轻轻松松地躲过去，然后再接着潜伏起来吧。"
	    global.pliot_dodge_name[i,j]="鬼人正邪"
	        global.pliot_dodge_voice[i,j]=sound36_piano2
	        global.pliot_dodge_head[i,j]=thh30_seija
	        global.pliot_dodge_face[i,j]=0
	    j=2
	    global.pliot_dodge_text[i,j]="[\\ag:180]以我的操舵技术，怎么可能会被你们这帮乌合之众击坠。"
	    global.pliot_dodge_name[i,j]="鬼人正邪"
	        global.pliot_dodge_voice[i,j]=sound36_piano2
	        global.pliot_dodge_head[i,j]=thh30_seija
	        global.pliot_dodge_face[i,j]=0
	    global.pliot_dodge_num[i]=j+1
    
	    j=0
	    global.pliot_dead_text[i,j]="[\\ag:180]鬼人一身[\\ag:0]阁下的隐藏机关，启动失败了吗……"
	    j=1
	    global.pliot_dead_text[i,j]="成为F2A的宿主……代价比想象中的还要大呢。"
	    j=2
	    global.pliot_dead_text[i,j]="[\\ag:180]我记下了，叼你妈的，老子跟你没完。"
	    global.pliot_dead_name[i,j]="鬼人正邪"
	        global.pliot_dead_voice[i,j]=sound36_piano2
	        global.pliot_dead_head[i,j]=thh30_seija
	        global.pliot_dead_face[i,j]=0
	    global.pliot_dead_num[i]=j+1
    
	    j=0
	    global.pliot_wep_text[i,j]="1/6兵人准备，魔动力ciws瞄准前方敌机，发射！"
    
	    j=1
	    global.pliot_wep_text[i,j]="[\\ag:180]说是魔动力实际上是人力吧喂！"
	    global.pliot_wep_name[i,j]="鬼人正邪"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh30_seija
	        global.pliot_wep_face[i,j]=0
    
	    j=2
	    global.pliot_wep_text[i,j]="[\\ag:180]射界良好，动力炉稳定，可以发射了。"
	    global.pliot_wep_name[i,j]="鬼人正邪"
	        global.pliot_wep_voice[i,j]=sound36_piano2
	        global.pliot_wep_head[i,j]=thh30_seija
	        global.pliot_wep_face[i,j]=0
        
	    j=3
