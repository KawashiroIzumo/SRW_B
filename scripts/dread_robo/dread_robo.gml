/// @description dread_robo(rid)
/// @param rid
function dread_robo(argument0) {
	var qlocal="roboset\\roboset",commad="",cuss,lscommad="";
	var i=argument0
	if(i<10)qlocal+="0"
	qlocal+=string(i)
	var jlocal=qlocal+".json";
	qlocal+=".nmsl"
	if(file_exists(qlocal))
	{
	    //show_message(qlocal+" sucess")
	    var fin; 
	    fin=file_text_open_read(qlocal)
	    commad=file_text_read_string(fin)//说明
	    file_text_readln(fin)
	    commad=file_text_read_string(fin)//机体名称
	    cuss=string_pos(",",commad)
	    lscommad=string_copy(commad,1,cuss-1)
	    global.robo_name[i]=lscommad
	    file_text_readln(fin)
	    global.robo_mov[i]=file_text_read_real(fin)//机体移动力
	    file_text_readln(fin)
	    global.robo_hp[i]=file_text_read_real(fin)//机体HP    
	    file_text_readln(fin)
	    global.robo_hp_mod_max[i]=file_text_read_real(fin)//机体HP改造
	    file_text_readln(fin)
	    global.robo_en[i]=file_text_read_real(fin)//机体EN
	    file_text_readln(fin)
	    global.robo_en_mod_max[i]=file_text_read_real(fin)//机体EN改造
	    file_text_readln(fin)
	    global.robo_def[i]=file_text_read_real(fin)//机体def    
	    file_text_readln(fin)
	    global.robo_def_mod_max[i]=file_text_read_real(fin)//机体def改造
	    file_text_readln(fin)
	    global.robo_ac[i]=file_text_read_real(fin)//机体机动性    
	    file_text_readln(fin)
	    global.robo_ac_mod_max[i]=file_text_read_real(fin)//机体机动性改造
	    file_text_readln(fin)
	    global.robo_ab[i]=file_text_read_real(fin)//机体照准
	    file_text_readln(fin)
	    global.robo_ab_mod_max[i]=file_text_read_real(fin)//机体照准改造
	    file_text_readln(fin)
	    global.robo_wep_mod_max[i]=file_text_read_real(fin)//机体武器改造    
	    file_text_readln(fin)
	    global.robo_costom[i]=file_text_read_real(fin)//机体5改奖励
	    for(j=0;j<4;j++)
	    {
	        file_text_readln(fin)
	        global.robo_place[i,j]=file_text_read_real(fin)//地形适应
	        file_text_readln(fin)
	        global.robo_place_go[i,j]=file_text_read_real(fin)//可以前往此地形
	    }
	    file_text_readln(fin)
	    global.robo_value[i]=file_text_read_real(fin)
	    file_text_readln(fin)
	    global.robo_exp_value[i]=file_text_read_real(fin)
	    file_text_readln(fin)
	    global.robo_tx[i]=file_text_read_real(fin)
	    file_text_readln(fin)//机体图标
	    global.robo_icon[i]=sprite_check(file_text_read_string(fin))
	    file_text_readln(fin)
	    global.robo_spr_stand[i]=sprite_check(file_text_read_string(fin))
	    file_text_readln(fin)
	    global.robo_spr_ldash[i]=sprite_check(file_text_read_string(fin))
	    file_text_readln(fin)
	    global.robo_spr_rdash[i]=sprite_check(file_text_read_string(fin))
	    file_text_readln(fin)
	    global.robo_spr_hurt[i]=sprite_check(file_text_read_string(fin))
	    file_text_readln(fin)
	    global.robo_spr_defence[i]=sprite_check(file_text_read_string(fin))
	    file_text_readln(fin)
	    global.robo_spr_guand[i]=sprite_check(file_text_read_string(fin))
	    file_text_readln(fin)
	    global.robo_spr_death[i]=sprite_check(file_text_read_string(fin))
	    file_text_readln(fin)
	    global.robo_death_tml[i]=timeline_check(file_text_read_string(fin))
	    file_text_readln(fin)
	    commad=file_text_read_string(fin)
	    var gofa=false
	    for(j=0;j<40;j++)
	    {
	        cuss=string_pos(";",commad)
	        if(cuss==0)
	        {
	            break;
	        }
	        lscommad=string_copy(commad,1,cuss-1)
	        commad=string_copy(commad,cuss+1,1000)
	        global.robo_mod_friend[i,j]=real(lscommad)
	        if(gofa)break;
	        //机体的改造关联机体（闪光高达->神高达 牛高达->海牛高达）
	    }
	    file_text_readln(fin)
	    commad=file_text_read_string(fin)
	    var gofa=false
	    for(j=0;j<40;j++)
	    {
	        cuss=string_pos(";",commad)
	        if(cuss==0)
	        {
	            break;
	        }
	        lscommad=string_copy(commad,1,cuss-1)
	        commad=string_copy(commad,cuss+1,1000)
	        global.robo_transform[i,j]=real(lscommad)
	        if(gofa)break;
	        //机体的变形（泰坦3，盖塔）对象
	    }
	    file_text_readln(fin)
	    commad=file_text_read_string(fin)
	    var gofa=false
	    for(j=0;j<40;j++)
	    {
	        cuss=string_pos(";",commad)
	        if(cuss==0)
	        {
	            break;
	        }
	        lscommad=string_copy(commad,1,cuss-1)
	        commad=string_copy(commad,cuss+1,1000)
	        global.robo_fl[i,j]=real(lscommad)
	        if(gofa)break;
	        //机体的分离（黑百合、灵格斯）对象
	    }
	    file_text_readln(fin)
	    commad=file_text_read_string(fin)
	    var gofa=false
	    for(j=0;j<40;j++)
	    {
	        cuss=string_pos(";",commad)
	        if(cuss==0)
	        {
	            break;
	        }
	        lscommad=string_copy(commad,1,cuss-1)
	        commad=string_copy(commad,cuss+1,1000)
	        global.robo_hz[i,j]=real(lscommad)
	        if(gofa)break;
	        //机体的换装对象（强袭、夏日花）
	    }
	    file_text_readln(fin)
	    commad=file_text_read_string(fin)
	    var gofa=false
	    for(j=0;j<10;j++)
	    {
	        cuss=string_pos(";",commad)
	        if(cuss==0)
	        {
	            break;
	        }
	        lscommad=string_copy(commad,1,cuss-1)
	        commad=string_copy(commad,cuss+1,1000)
	        global.robo_wep[i,j]=real(lscommad)
	        if(gofa)break;
	        //机体的武器
	    }
	    file_text_readln(fin)
	    commad=file_text_read_string(fin)
	    var gofa=false
	    for(j=0;j<40;j++)
	    {
	        cuss=string_pos(";",commad)
	        if(cuss==0)
	        {
	            break;
	        }
	        lscommad=string_copy(commad,1,cuss-1)
	        commad=string_copy(commad,cuss+1,1000)
	        global.robo_special[i,j]=real(lscommad)
	        if(gofa)break;
	        //机体的换装对象（强袭、夏日花）
	    }
	    file_text_readln(fin)
	    if(file_text_eof(fin)==false)
	    {
	        commad=file_text_read_string(fin)
	        cuss=string_pos(",",commad)
	        lscommad=string_copy(commad,1,cuss-1)
	        if(asset_get_type(lscommad)==asset_sound)
	        {
	            global.robo_BGM[i]=asset_get_index(lscommad)
	            //show_message(global.robo_name[i]+"的BGM是 "+lscommad)
	        }
	    }
	    file_text_readln(fin)
	    //else show_message(global.robo_name[i]+"没有BGM")
	    if(file_text_eof(fin)==false)
	    {
	        global.robo_ship[i]=file_text_read_real(fin)
	    }
	    file_text_readln(fin)
	    if(file_text_eof(fin)==false)
	    {
	        global.robo_equip_box[i]=file_text_read_real(fin)
	    }
	    file_text_readln(fin)
	    if(file_text_eof(fin)==false)
	    {
	        global.robo_magic[i]=file_text_read_real(fin)
	    }
	    file_text_readln(fin)
	    file_text_close(fin)
	}
	else if(file_exists(jlocal))
	{
		var qtext="";
		var fin; 
	    fin=file_text_open_read(jlocal)
		while(!file_text_eof(fin))
		{
			qtext+=file_text_read_string(fin)
			file_text_readln(fin)
			qtext+=chr(13)		
		}
		file_text_close(fin)
	    var lsstruct=json_parse(qtext)
		if(variable_struct_exists(lsstruct,"name"))global.robo_name[i]=lsstruct.name
	    if(variable_struct_exists(lsstruct,"move"))global.robo_mov[i]=lsstruct.move
	    if(variable_struct_exists(lsstruct,"HP"))global.robo_hp[i]=lsstruct.HP
	    if(variable_struct_exists(lsstruct,"HP_kai"))global.robo_hp_mod_max[i]=lsstruct.HP_kai
	    if(variable_struct_exists(lsstruct,"EN"))global.robo_en[i]=lsstruct.EN
	    if(variable_struct_exists(lsstruct,"EN_kai"))global.robo_en_mod_max[i]=lsstruct.EN_kai
	    if(variable_struct_exists(lsstruct,"def"))global.robo_def[i]=lsstruct.def
	    if(variable_struct_exists(lsstruct,"def_kai"))global.robo_def_mod_max[i]=lsstruct.def_kai
	    if(variable_struct_exists(lsstruct,"ac"))global.robo_ac[i]=lsstruct.ac
	    if(variable_struct_exists(lsstruct,"ac_kai"))global.robo_ac_mod_max[i]=lsstruct.ac_kai
	    if(variable_struct_exists(lsstruct,"ab"))global.robo_ab[i]=lsstruct.ab
	    if(variable_struct_exists(lsstruct,"ab_kai"))global.robo_ab_mod_max[i]=lsstruct.ab_kai
	    if(variable_struct_exists(lsstruct,"wep_kai"))global.robo_wep_mod_max[i]=lsstruct.wep_kai
	    if(variable_struct_exists(lsstruct,"kai_bouns"))global.robo_costom[i]=lsstruct.kai_bouns
		var vc=["_air","_ground","_sea","_space"]
	    for(j=0;j<4;j++)
	    {
	        if(variable_struct_exists(lsstruct,"place"+vc[j]))global.robo_place[i,j]=variable_struct_get(lsstruct,"place"+vc[j])//地形适应
	        if(variable_struct_exists(lsstruct,"place_allow"+vc[j]))global.robo_place_go[i,j]=variable_struct_get(lsstruct,"place_allow"+vc[j])//可以前往此地形
	    }
	    //0=- 1=C 2=B 3=A 4=S
	    //j=0:空 j=1:陆 j=2:水 j=3:宇
	    if(variable_struct_exists(lsstruct,"value"))global.robo_value[i]=lsstruct.value
	    if(variable_struct_exists(lsstruct,"exp_value"))global.robo_exp_value[i]=lsstruct.exp_value
	    if(variable_struct_exists(lsstruct,"scale"))global.robo_tx[i]=lsstruct.scale
	    if(variable_struct_exists(lsstruct,"icon"))
		{
			var sid=asset_get_index(lsstruct.icon)
			if(sprite_exists(sid))
			{
				global.robo_icon[i]=sid
			}
		}
	    if(variable_struct_exists(lsstruct,"spr_spine"))
		{
			var sid=asset_get_index(lsstruct.spr_spine)
			if(sprite_exists(sid))
			{
				global.robo_spr_spine[i]=sid
			}
		}
		if(sprite_exists(global.robo_spr_spine[i]))
		{
			global.robo_spr_stand[i]=global.robo_spr_spine[i]
			global.robo_spr_ldash[i]=roboCM_ldash
			global.robo_spr_rdash[i]=roboCM_rdash
			global.robo_spr_hurt[i]=roboCM_hurt
			global.robo_spr_defence[i]=roboCM_defence
			global.robo_spr_guand[i]=roboCM_guard
			global.robo_spr_boom[i]=roboCM_boom
		}
		else
		{
		    if(variable_struct_exists(lsstruct,"spr_stand"))
			{
				var sid=asset_get_index(lsstruct.spr_stand)
				if(sprite_exists(sid))
				{
					global.robo_spr_stand[i]=sid
				}
			}
		    if(variable_struct_exists(lsstruct,"spr_ldash"))
			{
				var sid=asset_get_index(lsstruct.spr_ldash)
				if(sprite_exists(sid))
				{
					global.robo_spr_ldash[i]=sid
				}
			}
		    if(variable_struct_exists(lsstruct,"spr_rdash"))
			{
				var sid=asset_get_index(lsstruct.spr_rdash)
				if(sprite_exists(sid))
				{
					global.robo_spr_rdash[i]=sid
				}
			}
		    if(variable_struct_exists(lsstruct,"spr_hurt"))
			{
				var sid=asset_get_index(lsstruct.spr_hurt)
				if(sprite_exists(sid))
				{
					global.robo_spr_hurt[i]=sid
				}
			}
		    if(variable_struct_exists(lsstruct,"spr_defence"))
			{
				var sid=asset_get_index(lsstruct.spr_defence)
				if(sprite_exists(sid))
				{
					global.robo_spr_defence[i]=sid
				}
			}
		    if(variable_struct_exists(lsstruct,"spr_guard"))
			{
				var sid=asset_get_index(lsstruct.spr_guard)
				if(sprite_exists(sid))
				{
					global.robo_spr_guand[i]=sid
				}
			}
		    if(variable_struct_exists(lsstruct,"spr_boom"))
			{
				var sid=asset_get_index(lsstruct.spr_boom)
				if(sprite_exists(sid))
				{
					global.robo_spr_death[i]=sid
				}
			}
		    if(variable_struct_exists(lsstruct,"spr_swep_combat_pose"))
			{
				var sid=asset_get_index(lsstruct.spr_swep_combat_pose)
				if(sprite_exists(sid))
				{
					global.robo_spr_swep_combat_pose[i]=sid
				}
			}
		    if(variable_struct_exists(lsstruct,"spr_swep_combat_in"))
			{
				var sid=asset_get_index(lsstruct.spr_swep_combat_in)
				if(sprite_exists(sid))
				{
					global.robo_spr_swep_combat_in[i]=sid
				}
			}
		    if(variable_struct_exists(lsstruct,"spr_swep_combat_miss"))
			{
				var sid=asset_get_index(lsstruct.spr_swep_combat_miss)
				if(sprite_exists(sid))
				{
					global.robo_spr_swep_combat_miss[i]=sid
				}
			}
		    if(variable_struct_exists(lsstruct,"spr_swep_shoot_pose"))
			{
				var sid=asset_get_index(lsstruct.spr_swep_shoot_pose)
				if(sprite_exists(sid))
				{
					global.robo_spr_swep_shoot_pose[i]=sid
				}
			}
		}
		if(variable_struct_exists(lsstruct,"spr_death_effect_timeline"))
		{
			var sid=asset_get_index(lsstruct.spr_death_effect_timeline)
			if(timeline_exists(sid))
			{
				global.robo_death_tml[i]=sid
			}
		}
		if(variable_struct_exists(lsstruct,"wep"))
		{
			if(is_array(lsstruct.wep))
			{
				for(j=0;j<array_length(lsstruct.wep);j++)
				{
					global.robo_wep[i,j]=lsstruct.wep[j]
				}
			}
		}
		if(variable_struct_exists(lsstruct,"wep_enabled"))
		{
			if(is_array(lsstruct.wep_enabled))
			{
				for(j=0;j<array_length(lsstruct.wep_enabled);j++)
				{
					global.robo_wep_enabled[i,j]=lsstruct.wep_enabled[j]
				}
			}
		}
		if(variable_struct_exists(lsstruct,"sub_pliot"))
		{
			if(is_array(lsstruct.sub_pliot))
			{
				for(j=0;j<array_length(lsstruct.sub_pliot);j++)
				{
					global.robo_sub_pliot[i,j]=lsstruct.sub_pliot[j]
				}
			}
		}
		if(variable_struct_exists(lsstruct,"robo_kai_lock"))
		{
			if(is_array(lsstruct.robo_kai_lock))
			{
				for(j=0;j<array_length(lsstruct.robo_kai_lock);j++)
				{
					global.robo_mod_friend[i,j]=lsstruct.robo_kai_lock[j]
				}
			}
		}
		if(variable_struct_exists(lsstruct,"robo_change_lock"))
		{
			if(is_array(lsstruct.robo_change_lock))
			{
				for(j=0;j<array_length(lsstruct.robo_change_lock);j++)
				{
					global.robo_transform[i,j]=lsstruct.robo_change_lock[j]
				}
			}
		}
		if(variable_struct_exists(lsstruct,"robo_jackoff_lock"))
		{
			if(is_array(lsstruct.robo_jackoff_lock))
			{
				for(j=0;j<array_length(lsstruct.robo_jackoff_lock);j++)
				{
					global.robo_fl[i,j]=lsstruct.robo_jackoff_lock[j]
				}
			}
		}
		if(variable_struct_exists(lsstruct,"robo_backpack_lock"))
		{
			if(is_array(lsstruct.robo_backpack_lock))
			{
				for(j=0;j<array_length(lsstruct.robo_backpack_lock);j++)
				{
					global.robo_hz[i,j]=lsstruct.robo_backpack_lock[j]
				}
			}
		}
		if(variable_struct_exists(lsstruct,"special"))
		{
			if(is_array(lsstruct.special))
			{
				for(j=0;j<array_length(lsstruct.special);j++)
				{
					global.robo_special[i,j]=lsstruct.special[j]
				}
			}
		}
	    if(variable_struct_exists(lsstruct,"BGM"))
		{
			var sid=asset_get_index(lsstruct.BGM)
			if(sound_exists(sid))
			{
				global.robo_BGM[i]=sid
			}
		}
	    if(variable_struct_exists(lsstruct,"is_ship"))global.robo_ship[i]=lsstruct.is_ship
		if(variable_struct_exists(lsstruct,"is_magic"))global.robo_magic[i]=lsstruct.is_magic//是魔法机体
	    if(variable_struct_exists(lsstruct,"equip_slot"))global.robo_equip_box[i]=lsstruct.equip_slot//可装备芯片数量
	    
	}



}
