/// @description database_perk()
function database_perk() {
	//
	for(i=0;i<256;i++)
	{
	    global.perk_name[i]="新人类"
	    global.perk_text[i]="可以根据新人类等级增加最终的命中率和回避率，除此之外也可使用新人类专属的武器"
	    global.perk_ql[i]=0//perk的发动气力
	    global.perk_wake_script[i]=noone//perk觉醒时发生的事件
	    global.perk_turn_script[i]=noone//每回合开始时会发生的事件
	    global.perk_battle_end_script[i]=noone//每次战斗结束时会发生的事件
	}
	//========-=====-=======-=====-==-=-===-=====-=======
	i=0
	global.perk_name[i]="新人类"
	global.perk_text[i]="可以根据新人类等级增加最终的命中率和回避率，除此之外也可使用新人类专属的武器"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=1
	global.perk_name[i]="强化人"
	global.perk_text[i]="等同于新人类，可以根据强化人等级增加最终的命中率和回避率，除此之外也可使用新人类专属的武器"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=2
	global.perk_name[i]="神职人员"
	global.perk_text[i]="可以根据神职人员等级增加最终的命中率，且每回合开始前可以根据神职人员等级恢复SP"
	global.perk_ql[i]=0//perk的发动气力
	global.perk_turn_script[i]=perk02s00_miko
	//========-=====-=======-=====-==-=-===-=====-=======
	i=3
	global.perk_name[i]="魔法师"
	global.perk_text[i]="可以根据魔法师等级减少最终受到的伤害，若机体是魔法机体，则每等级基础MP+10"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=4
	global.perk_name[i]="飞龙探云手"
	global.perk_text[i]="每次战斗之后都能偷到钱。数量和飞龙探云手等级相关"
	global.perk_ql[i]=0//perk的发动气力
	global.perk_battle_end_script[i]=perk04s00_sneak
	//========-=====-=======-=====-==-=-===-=====-=======
	i=5
	global.perk_name[i]="天才"
	global.perk_text[i]="作为主机师时，命中·回避·暴击的几率各增加20%"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=6
	global.perk_name[i]="冰之妖精"
	global.perk_text[i]="作为主机师时，若使用名字带有“冰”、“雪”、“冷”、“冻”的武器，则威力上升9%，射程+1"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=7
	global.perk_name[i]="冰川学家"
	global.perk_text[i]="每回合，SP恢复9%。#机体若使用MP作为能源，则MP也恢复9%，机体若使用EN作为能源则无效。"
	global.perk_ql[i]=0//perk的发动气力
	global.perk_turn_script[i]=perk07s00_iceprofeccer
	//========-=====-=======-=====-==-=-===-=====-=======
	i=8
	global.perk_name[i]="灵光力"
	global.perk_text[i]="可以根据灵光力等级增加最终造成的伤害，提升回避率。"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=9
	global.perk_name[i]="底力"
	global.perk_text[i]="随着HP降低，提升自机造成的伤害，降低自机受到的伤害。"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=10
	global.perk_name[i]="歌手"
	global.perk_text[i]="作为主机师时，若机体拥有“ROBOT魂”特质，就可以使用音乐CD为队友提供强大的加成"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=11
	global.perk_name[i]="麒麟"
	global.perk_text[i]="作为主机师时，每回合机体的HP恢复5%，此特性每提升一级，回复量+5%"
	global.perk_ql[i]=0//perk的发动气力
	global.perk_turn_script[i]=perk11s00_kirin
	//========-=====-=======-=====-==-=-===-=====-=======
	i=12
	global.perk_name[i]="化冰博士"
	global.perk_text[i]="作为主机师时，若已经进行了九场战斗，则人格会发生改变"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=13
	global.perk_name[i]="剑仙"
	global.perk_text[i]=@"作为主机师时，格斗武器的伤害+500
#除此之外，当你成为格斗武器的目标时，可以根据剑仙等级提高回避率。"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=14
	global.perk_name[i]="素色云界旗（山寨）"
	global.perk_text[i]=@"你的身体由概率云构成，这使你只会承受10%伤害。但是你持有的任何力场系/特殊回避系效应无法生效"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=15
	global.perk_name[i]="因果律操纵"
	global.perk_text[i]="可以根据因果律等级增加最终的命中率和回避率，除此之外也可使用因果律武器"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======
	i=16
	global.perk_name[i]="创战者"
	global.perk_text[i]="作为主机师时，装备的所有robot魂武器会在回合开始时恢复全部弹药"
	global.perk_ql[i]=0//perk的发动气力
	global.perk_turn_script[i]=perk16s00_bulidfighter
	//========-=====-=======-=====-==-=-===-=====-=======
	i=17
	global.perk_name[i]="警察官"
	global.perk_text[i]=@"增加你先手攻击造成的伤害，在敌方先手攻击时增加你的防御力"
	global.perk_ql[i]=0//perk的发动气力
	//========-=====-=======-=====-==-=-===-=====-=======


}
