/// @description database_map()
function database_map()
{
	//--=-=-=======---+++**--======-//=-=-===-=
	i=0
	global.map_name[i]="殖民卫星龟褚区"
	global.map_w[i]=30
	global.map_h[i]=30
	global.map_space[i]=0
	global.map_pic[i]=map0000
	global.map_bak[i]=map0000_bak
	global.map_bks_script[i]=mbks00_colony
	global.map_bks_sky[i]=bks00_normalsky
	global.map_bks_far[i]=bks01_cityfar
	for(dy=0;dy<100;dy+=1)
	{
	    for(dx=0;dx<100;dx+=1)
	    {
	        global.map_dtype[i,dy*100+dx]=0
	    }
	}
	//开始生成地图
	var lsur;
	lsur=surface_create(global.map_w[i],global.map_h[i])
	surface_set_target(lsur)
	draw_background(global.map_pic[i],0,0)
	for(dy=0;dy<global.map_h[i];dy+=1)
	{
	    for(dx=0;dx<global.map_w[i];dx+=1)
	    {
	        a=surface_getpixel(lsur,dx,dy)
			//show_message(global.map_name[i]+"的（"+string(dx)+","+string(dy)+"）处颜色是"+string(a))
	        global.map_dtype[i,dy*100+dx]=colour_to_dtype(a)
	    }
	}
	surface_reset_target()
	surface_free(lsur)
	//--=-=-=======---+++**--======-//=-=-===-=
	i=1
	global.map_name[i]="宇宙空间"
	global.map_w[i]=30
