/// @description database_robo()
function database_robo() {
	//机体数据
	var i;
	for(i=0;i<512;i++)
	{
	    global.robo_name[i]="UNKNOW"
	    global.robo_mov[i]=6
	    global.robo_hp[i]=3700//HP
	    global.robo_hp_mod_max[i]=10//HP最大改造段数
	    global.robo_en[i]=120
	    global.robo_en_mod_max[i]=10//HP最大改造段数
	    global.robo_def[i]=900
	    global.robo_def_mod_max[i]=10//装甲最大改造段数
	    global.robo_ac[i]=110
	    global.robo_ac_mod_max[i]=10//机动性最大改造段数
	    global.robo_ab[i]=125
	    global.robo_ab_mod_max[i]=10//照准值最大改造段数
	    global.robo_wep_mod_max[i]=0//武器最大改造段数
	    global.robo_costom[i]=0//机体的自订奖励类型(5改奖励)
	    for(j=0;j<4;j++)
	    {
	        global.robo_place[i,j]=3//地形适应
	        global.robo_place_go[i,j]=true//可以前往此地形
	    }
	    //0=- 1=C 2=B 3=A 4=S
	    //j=0:空 j=1:陆 j=2:水 j=3:宇
	    global.robo_value[i]=1250
	    global.robo_exp_value[i]=300
	    global.robo_tx[i]=0//-2:SS,-1:S,0:M,1:L,2:LL
	    global.robo_icon[i]=robo00_gundam
	    global.robo_spr_spine[i]=noone
	    global.robo_spr_stand[i]=robo00s00_stand
	    global.robo_spr_ldash[i]=robo00s00_ldash
	    global.robo_spr_rdash[i]=robo00s00_rdash
	    global.robo_spr_hurt[i]=robo00s00_hurt
	    global.robo_spr_defence[i]=robo00s00_defence
	    global.robo_spr_guand[i]=robo00s00_guand
	    global.robo_spr_death[i]=robo00s00_boom
	    global.robo_spr_swep_combat_pose[i]=robo22s00_swep_combat_pose
	    global.robo_spr_swep_combat_in[i]=robo22s00_swep_combat_in
	    global.robo_spr_swep_combat_miss[i]=robo22s00_swep_combat_miss
	    global.robo_spr_swep_shoot_pose[i]=robo22s00_swep_shoot_pose
	    global.robo_death_tml[i]=robo_death_con_tml
	    for(j=0;j<10;j++)
	    {
	        global.robo_wep[i,j]=-1    
	        global.robo_wep_enabled[i,j]=1//是否为初始可用武器
        
	        global.robo_sub_pliot[i,j]=-1//机体自带的副机师
	    }
	    for(j=0;j<40;j++)
	    {
	        global.robo_mod_friend[i,j]=-1//机体的改造关联机体（闪光高达->神高达 牛高达->海牛高达）
	        global.robo_transform[i,j]=-1//机体的变形（泰坦3，盖塔）对象
	        global.robo_fl[i,j]=-1//机体的分离（黑百合、灵格斯）对象
	        global.robo_hz[i,j]=-1//机体的换装对象（强袭、夏日花）
	    }
	    for(j=0;j<40;j++)
	    {
	        global.robo_special[i,j]=-1
	    }
	    global.robo_BGM[i]=noone
	    global.robo_ship[i]=false
	    global.robo_equip_box[i]=4//可装备芯片数量
	    global.robo_magic[i]=false//是魔法机体
	    dread_robo(i)
	}
	//====================================================
	i=0
	global.robo_wep_enabled[i,3]=0
	//====================================================
	i=1
	global.robo_sub_pliot[i,0]=18
	//====================================================
	i=2
	global.robo_wep_enabled[i,3]=0
	global.robo_sub_pliot[i,0]=10
	//====================================================
	i=9
	global.robo_wep_enabled[i,2]=0
	global.robo_spr_swep_combat_pose[i]=robo09s00_swep_combat_pose
	global.robo_spr_swep_combat_in[i]=robo09s00_swep_combat_in
	global.robo_spr_swep_combat_miss[i]=robo09s00_swep_combat_miss
	global.robo_spr_swep_shoot_pose[i]=robo09s00_swep_shoot_pose
	//====================================================
	i=11
	global.robo_sub_pliot[i,0]=14
	//====================================================
	i=12
	global.robo_wep_enabled[i,3]=0
	//====================================================
	i=13
	global.robo_wep_enabled[i,3]=0
	//====================================================
	i=16
	global.robo_wep_enabled[i,1]=0
	global.robo_sub_pliot[i,0]=18
	//====================================================
	i=17
	global.robo_sub_pliot[i,0]=19
	//====================================================
	i=18
	global.robo_sub_pliot[i,0]=20
	//====================================================
	i=19
	global.robo_sub_pliot[i,0]=21
	//====================================================
	i=20
	global.robo_sub_pliot[i,0]=22
	//====================================================
	i=22
	global.robo_wep_enabled[i,2]=0
	//====================================================
	i=24
	global.robo_wep_enabled[i,3]=0
	global.robo_sub_pliot[i,0]=23
	//====================================================
	i=25
	global.robo_sub_pliot[i,0]=38
	global.robo_sub_pliot[i,1]=39
	//====================================================
	i=32
	global.robo_wep_enabled[i,2]=0
	//====================================================
	i=33
	global.robo_spr_swep_combat_pose[i]=robo33s00_swep_combat_pose
	global.robo_spr_swep_combat_in[i]=robo33s00_swep_combat_in
	global.robo_spr_swep_combat_miss[i]=robo33s00_swep_combat_miss
	global.robo_spr_swep_shoot_pose[i]=robo33s00_swep_shoot_pose
	//====================================================
	i=34
	global.robo_sub_pliot[i,0]=12
	global.robo_spr_swep_combat_pose[i]=robo34s00_swep_combat_pose
	global.robo_spr_swep_combat_in[i]=robo34s00_swep_combat_in
	global.robo_spr_swep_combat_miss[i]=robo34s00_swep_combat_miss
	global.robo_spr_swep_shoot_pose[i]=robo34s00_swep_shoot_pose
	//====================================================
	i=35
	global.robo_spr_swep_combat_pose[i]=robo35s00_swep_combat_pose
	global.robo_spr_swep_combat_in[i]=robo35s00_swep_combat_in
	global.robo_spr_swep_combat_miss[i]=robo35s00_swep_combat_miss
	global.robo_spr_swep_shoot_pose[i]=robo35s00_swep_shoot_pose
	//====================================================
	i=45
	global.robo_spr_swep_combat_pose[i]=robo45s00_swep_combat_pose
	global.robo_spr_swep_combat_in[i]=robo45s00_swep_combat_in
	global.robo_spr_swep_combat_miss[i]=robo45s00_swep_combat_miss
	global.robo_spr_swep_shoot_pose[i]=robo45s00_swep_shoot_pose
	//====================================================
	i=49
	global.robo_spr_swep_combat_pose[i]=robo49s00_swep_combat_pose
	global.robo_spr_swep_combat_in[i]=robo49s00_swep_combat_hit
	global.robo_spr_swep_combat_miss[i]=robo49s00_swep_combat_miss
	global.robo_spr_swep_shoot_pose[i]=robo49s00_swep_shoot_pose
	//====================================================
	i=56
	global.robo_spr_swep_combat_pose[i]=robo49s00_swep_combat_pose
	global.robo_spr_swep_combat_in[i]=robo49s00_swep_combat_hit
	global.robo_spr_swep_combat_miss[i]=robo49s00_swep_combat_miss
	global.robo_spr_swep_shoot_pose[i]=robo49s00_swep_shoot_pose
	//====================================================
	i=57
	global.robo_spr_swep_combat_pose[i]=robo57s00_swep_shoot_pose
	global.robo_spr_swep_combat_in[i]=robo57s00_swep_combat_hit
	global.robo_spr_swep_combat_miss[i]=robo57s00_swep_combat_miss
	global.robo_spr_swep_shoot_pose[i]=robo57s00_swep_shoot_pose
	//====================================================


}
