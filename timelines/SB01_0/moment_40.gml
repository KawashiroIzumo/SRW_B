    global.mrobo_pliot_ql[a]=120//吃不起饭啦
    while(global.pliot_lv[9]<10)
    {
        pliot_lvup(9)
    }
    mrobo_get_wep(a,54)
    mrobo_get_wep(a,56)
    mrobo_add_equip(a,0,10)
    mrobo_add_equip(a,1,6)
    global.mrobo_pliot_sp[a]=global.pliot_sp[9]
    mrobo_refrish(a)
}
