/// @description 刘醒对话内容
qname="刘醒"
qtext=@"是卡拉巴电竞战队的55号，真名伍本伟。
#早年间在澳门赌场斗地主，自称土块。输到破产后没有办法才去打比赛的。
#机体的话，是提坦斯最新研发的海兹尔高达。
"
qhead=po31_liuxing
a=create_dhk(qname,qtext,qhead)
with(talk_scene)
{
    i=0
    actor_sprite[i]=plo31_liuxing_talk
	actor_image_index[i]=0
	actor_combo_nj[i]=2
	actor_speed[i]=0
    actor_combo[i]=plo31_liuxing_stand
    i=1
    actor_sprite[i]=plo32_police_stand
	actor_speed[i]=0
    actor_combo[i]=noone
    i=2
    actor_sprite[i]=plo32_police_stand
	actor_speed[i]=0
    actor_combo[i]=noone
	i=3
    actor_sprite[i]=plo33_feifan_stand
	actor_speed[i]=0
    actor_combo[i]=noone
}

