/// @description 黑场结束
with(talk_scene)
{    
    i=0
    actor_enable[i]=true
    actor_active[i]=true
    actor_play[i]=1
    actor_sprite[i]=fx02_jitps
    actor_combo[i]=noone
    actor_mirror[i]=false
    actor_speed[i]=-10
    
    i=1
    actor_enable[i]=true
    actor_active[i]=true
    actor_play[i]=false
    actor_sprite[i]=robo01s00_fly
    actor_combo[i]=noone
    actor_speed[i]=-10
    actor_mirror[i]=false
}

