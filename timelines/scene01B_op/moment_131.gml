/// @description 机体移动
with(talk_scene)
{    
    i=0
    actor_enable[i]=true
    actor_active[i]=true
    actor_play[i]=1
    actor_sprite[i]=fx02_jitps
    actor_combo[i]=noone
    actor_mirror[i]=0
    actor_x[i]=800+128
    actor_speed[i]=-10
    i=1
    actor_enable[i]=true
    actor_active[i]=true
    actor_play[i]=false
    actor_image_index[i]=9
    actor_sprite[i]=robo16s00_stand
    actor_combo[i]=noone
    actor_mirror[i]=0
    actor_x[i]=800
    actor_speed[i]=-10   
}

